# Copie para .env e ajuste os valores localmente. Nunca commitar .env real.

# String de conexão do PostgreSQL (obrigatória)
DATABASE_URL="postgresql://user:password@localhost:5432/verx?schema=public"

# development | test | production (default: development)
NODE_ENV="development"

# Porta HTTP da API (default: 3000)
PORT=3000
